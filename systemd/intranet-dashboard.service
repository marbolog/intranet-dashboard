[Unit]
Description=Intranet service dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marcello
Group=marcello
WorkingDirectory=/home/marcello/devel-with-claude/intranet-dashboard
ExecStart=/home/marcello/devel-with-claude/intranet-dashboard/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
